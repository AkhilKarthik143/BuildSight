# Copy to .env.local and fill in the values you have. Never commit .env.local.
# Names and placeholders only. Leave a line blank to keep that feature off.

# Preferred: Anthropic API key (console.anthropic.com, starts with sk-ant-)
ANTHROPIC_API_KEY=
# Fallback: OpenRouter key (starts with sk-or-v1-). Used only when ANTHROPIC_API_KEY is blank.
OPENROUTER_API_KEY=
# Optional model overrides. Leave blank to keep the defaults in src/lib/claude.ts.
ANTHROPIC_MODEL=
OPENROUTER_MODEL=

# Azure AI Speech (speech to text). The browser receives a short-lived token, not the key.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Cartesia text to speech. Voice id is optional.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Azure Application Insights. Blank means request metrics are a no-op.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional per-process cap on Claude routes per UTC day. Blank or 0 means off.
DAILY_CLAUDE_CALL_LIMIT=

# Azure Web PubSub. Blank uses the in-memory pairing transport (works with npm run dev).
WEBPUBSUB_CONNECTION_STRING=
